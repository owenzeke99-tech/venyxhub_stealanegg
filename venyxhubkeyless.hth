statusLabel.Text = ""
statusLabel.TextColor3 = Color3.fromRGB(235, 235, 242)
statusLabel.TextSize = 12
statusLabel.Font = Enum.Font.GothamBold
statusLabel.TextXAlignment = Enum.TextXAlignment.Center
statusLabel.TextTransparency = 1
statusLabel.Parent = statusBanner

local function setBannerState(message, mode)
	if message == "" then
		TweenService:Create(statusBanner, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
		TweenService:Create(bannerStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
		TweenService:Create(statusLabel, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
		task.delay(0.2, function()
			if statusBanner.BackgroundTransparency == 1 then
				statusLabel.Text = ""
			end
		end)
		return
	end

	statusLabel.Text = message
	statusLabel.TextTransparency = 1
	statusBanner.BackgroundTransparency = 1
	bannerStroke.Transparency = 1

	if mode == "error" then
		statusBanner.BackgroundColor3 = Color3.fromRGB(42, 18, 22)
		bannerStroke.Color = Color3.fromRGB(195, 70, 82)
		statusLabel.TextColor3 = Color3.fromRGB(255, 130, 140)
	elseif mode == "success" then
		statusBanner.BackgroundColor3 = Color3.fromRGB(18, 38, 26)
		bannerStroke.Color = Color3.fromRGB(95, 195, 130)
		statusLabel.TextColor3 = Color3.fromRGB(165, 240, 190)
	else
		statusBanner.BackgroundColor3 = Color3.fromRGB(30, 30, 37)
		bannerStroke.Color = Color3.fromRGB(120, 120, 136)
		statusLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
	end

	TweenService:Create(statusBanner, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.15
	}):Play()
	TweenService:Create(bannerStroke, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Transparency = 0.25
	}):Play()
	TweenService:Create(statusLabel, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TextTransparency = 0
	}):Play()
end

