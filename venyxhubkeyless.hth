-- Smooth Shake + Red Menu Border Glow on Invalid Key
local isShaking = false
local function triggerErrorFeedback(frame)
	if isShaking then return end
	isShaking = true

	local originPos = frame.Position
	local offsets = {6, -6, 4, -4, 2, -2, 0}
	local shakeInfo = TweenInfo.new(0.045, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

	TweenService:Create(mainStroke, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Color = errorBorderColor,
		Thickness = 2
	}):Play()

	for _, offset in ipairs(offsets) do
		local tween = TweenService:Create(frame, shakeInfo, {
			Position = originPos + UDim2.new(0, offset, 0, 0)
		})
		tween:Play()
		tween.Completed:Wait()
	end

	frame.Position = originPos

	task.delay(0.65, function()
		TweenService:Create(mainStroke, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Color = defaultBorderColor,
			Thickness = 1.4
		}):Play()
	end)

	isShaking = false
end

-- Load Venyx Hub on Valid Key
local function loadHub()
	saveKeySession(CORRECT_KEY)
	TweenService:Create(mainStroke, TweenInfo.new(0.2), {
		Color = successBorderColor,
		Thickness = 1.8
	}):Play()
	setBannerState("Access granted — loading Venyx Hub...", "success")
	task.wait(0.5)
	screenGui:Destroy()
	executeHub()
end

-- Get Key Button Click
getKeyButton.MouseButton1Click:Connect(function()
	if setclipboard then
		setclipboard(GET_KEY_LINK)
		setBannerState("Get Key link copied to clipboard", "info")
	else
		setBannerState("Link: " .. GET_KEY_LINK, "info")
	end
end)

-- Check Key Button Click
checkButton.MouseButton1Click:Connect(function()
	local enteredKey = keyInput.Text

	if enteredKey == "" then
		setBannerState("Please enter your key before continuing", "error")
		task.spawn(triggerErrorFeedback, mainFrame)
		return
	end

	if enteredKey == CORRECT_KEY then
		loadHub()
	else
		keyInput.Text = ""
		setBannerState("Invalid key — please try again", "error")
		task.spawn(triggerErrorFeedback, mainFrame)
	end
end)
