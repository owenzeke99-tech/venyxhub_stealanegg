local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Key & Get Key Configuration
local CORRECT_KEY = "VenyxHubKeyLsjwowoLalwowjaoJslwiPejwbwjwoi"
local GET_KEY_LINK = "https://link4m.net/qs9jhsaT"
local HUB_URL = "https://raw.githubusercontent.com/tienkhanh1/Venyx/main/VenyxHub"

-- Silent 24-Hour Key Persistence Config (No UI text mention)
local SAVE_FILE_NAME = "VenyxHub_Auth.json"
local KEY_DURATION_SECONDS = 86400 -- 24 hours

local function executeHub()
	local success, err = pcall(function()
		loadstring(game:HttpGet(HUB_URL))()
	end)
	if not success then
		warn("Failed to load Venyx Hub: " .. tostring(err))
	end
end

local function saveKeySession(key)
	if writefile then
		pcall(function()
			local payload = HttpService:JSONEncode({
				key = key,
				timestamp = os.time()
			})
			writefile(SAVE_FILE_NAME, payload)
		end)
	end
end

local function hasValidSavedSession()
	if isfile and readfile then
		local ok, result = pcall(function()
			if not isfile(SAVE_FILE_NAME) then
				return false
			end
			local raw = readfile(SAVE_FILE_NAME)
			local data = HttpService:JSONDecode(raw)
			if type(data) == "table" and data.key == CORRECT_KEY and type(data.timestamp) == "number" then
				if (os.time() - data.timestamp) < KEY_DURATION_SECONDS then
					return true
				end
			end
			return false
		end)
		if ok and result == true then
			return true
		end
	end
	return false
end

-- Auto-load immediately if a valid saved session exists
if hasValidSavedSession() then
	executeHub()
	return
end

